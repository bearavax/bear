# Copy this file to .env.local and fill in the values you need.

# Public base URL of the app (used to build magic-link sign-in URLs).
# If unset, the request origin is used automatically.
APP_URL=http://localhost:3000

# Where the SQLite database file lives. Defaults to ./worldcup.db
# DATABASE_PATH=./worldcup.db

# Token required to enter actual tournament results on the /admin page.
# Pick any hard-to-guess string. If unset, the admin page is disabled.
ADMIN_TOKEN=change-me-to-something-secret

# Set to "true" to lock predictions early (otherwise they lock at the
# tournament kickoff date defined in data/tournament.ts).
# PREDICTIONS_LOCKED=false

# --- Email (optional) -------------------------------------------------
# Sign-in uses passwordless "magic links". If no SMTP server is configured
# the magic link is shown directly on the sign-in page (dev mode) so you
# can still play without setting up email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM=World Cup Predictions <no-reply@example.com>
